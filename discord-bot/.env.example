# Copy this file to .env and fill in real values. .env is gitignored.

# Bot token from the Discord Developer Portal (Bot tab) — keep secret.
DISCORD_TOKEN=

# Application ID from the Developer Portal (General Information tab).
DISCORD_CLIENT_ID=

# Your server's ID (right-click the server icon with Developer Mode on,
# "Copy Server ID"). Used for fast guild-scoped slash command registration.
DISCORD_GUILD_ID=

# Channel IDs (right-click a channel, "Copy Channel ID") for scheduled posts.
DISTORTION_CHANNEL_ID=
THISWEEK_CHANNEL_ID=
